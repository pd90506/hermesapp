// Shared build settings for both app targets (referenced from project.yml).
//
// Signing: do NOT put your team id or real bundle prefix here. Copy
// Local.xcconfig.example to Local.xcconfig (git-ignored) and set them there.

// Placeholder reverse-DNS prefix; targets append .mac / .ios.
HERMES_BUNDLE_ID_PREFIX = com.example.hermesapp

// Empty = choose a team in Xcode, or set it in Local.xcconfig.
DEVELOPMENT_TEAM =

// Here rather than in project.yml, so Local.xcconfig can switch to a local certificate.
CODE_SIGN_STYLE = Automatic

// In-app updates (Mac). Empty = off. Set both in Local.xcconfig; see scripts/release-mac.sh.
HERMES_UPDATE_FEED_URL =
HERMES_UPDATE_PUBLIC_KEY =

// Optional per-developer overrides (missing file is fine).
#include? "Local.xcconfig"
